model User {
    id           String       @id @default(ulid())
    name         String       @db.VarChar(255)
    email        String       @unique
    password     String
    activeStatus ActiveStatus @default(ACTIVE)
    role         Role         @default(USER)
    profile      Profile?
    subscription Subscription?
    createdAt    DateTime     @default(now())
    updateAt     DateTime     @updatedAt

    posts    Post[]
    comments Comment[]

    @@map("users")
}
